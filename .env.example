# NextAuth — NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AniList OAuth App (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Discord App (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Database — Neon Postgres (pooled URL for DATABASE_URL, direct for migrations)
DATABASE_URL=
DIRECT_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encryption (CRITICAL — never commit) — openssl rand -hex 32
ENCRYPTION_KEY=

# Cron security — openssl rand -base64 32
CRON_SECRET=
